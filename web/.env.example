# Copy to web/.env.local — never commit real secrets.

# --- Public (safe for browser bundles) ---
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
NEXT_PUBLIC_ADMIN_URL=https://your-production-domain.example/admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted by the app:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
DATABASE_URL=postgresql://user:password@host:5432/sabjiwala?schema=public
PAYMENT_HMAC_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STAFF_BOOTSTRAP_PASSWORD=
STAFF_SESSION_SECRET=
STAFF_ADMIN_EMAILS=
STAFF_VENDOR_EMAILS=
STAFF_RIDER_EMAILS=

# Platform/runtime (GoDaddy sets PORT; bind host defaults to 0.0.0.0 in start script)
# PORT=3000
# HOST=0.0.0.0
# HOSTNAME=0.0.0.0
# NODE_ENV=production

# Optional: load demo catalog during seed (off by default in production)
# SEED_DEMO_DATA=1

# Supabase Storage — SERVER-ONLY product image uploads.
# Required before enabling admin/vendor product image uploads in production:
# 1. Create a public (or signed-URL) bucket in your Supabase project.
# 2. Set SUPABASE_PRODUCT_IMAGES_BUCKET to that bucket name (default: product-images).
# 3. Set SUPABASE_SERVICE_ROLE_KEY with a server-side service role key.
# Never expose SUPABASE_SERVICE_ROLE_KEY via NEXT_PUBLIC_* or client components.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# INTEGRATION_TEST_SECRET=
# CAPACITOR_SERVER_URL=https://your-production-domain.example
