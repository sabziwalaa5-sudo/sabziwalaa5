# Copy to web/.env.local — never commit real secrets.

NEXT_PUBLIC_APP_URL=https://web-sabziwalaa5.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://web-sabziwalaa5.vercel.app/admin

# Supabase (optional — customer Google/email login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name still accepted:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC.
DATABASE_URL=postgresql://user:password@host:5432/sabjiwala?schema=public
PAYMENT_HMAC_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Staff portals (required in production)
STAFF_BOOTSTRAP_PASSWORD=
STAFF_SESSION_SECRET=
STAFF_ADMIN_EMAILS=
STAFF_VENDOR_EMAILS=
STAFF_RIDER_EMAILS=

# Optional: native WebView host override
# CAPACITOR_SERVER_URL=https://web-sabziwalaa5.vercel.app
